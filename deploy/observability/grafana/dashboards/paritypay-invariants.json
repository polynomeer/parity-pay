{
  "title": "ParityPay — 불변조건과 운영 상태",
  "uid": "paritypay-invariants",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "INV-001 원장 불균형 (0이어야 함)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "paritypay_invariant_unbalanced_ledger_transactions" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "INV-003 음수 잔액 (0이어야 함)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "paritypay_invariant_negative_wallet_balances" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "INV-010 스냅샷·원장 불일치 (0이어야 함)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "paritypay_invariant_balance_snapshot_drift" }]
    },
    {
      "type": "stat",
      "title": "INV-005 초과 취소 (0이어야 함)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "paritypay_invariant_over_cancelled_payments" }]
    },
    {
      "type": "timeseries",
      "title": "Outbox 적체 (미발행 건수 / 가장 오래된 이벤트 나이)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "paritypay_outbox_pending", "legendFormat": "pending" },
        { "expr": "paritypay_outbox_failed", "legendFormat": "failed" },
        { "expr": "paritypay_outbox_oldest_pending_age_seconds", "legendFormat": "oldest age (s)" },
        { "expr": "paritypay_outbox_max_partition_pending", "legendFormat": "max per partition key" }
      ]
    },
    {
      "type": "timeseries",
      "title": "미확정 거래와 사람 확인 대기",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "paritypay_topup_unknown", "legendFormat": "unknown top-ups" },
        { "expr": "paritypay_recovery_manual_review", "legendFormat": "manual review" },
        { "expr": "paritypay_settlement_unsettled_payouts", "legendFormat": "unsettled payouts" },
        { "expr": "paritypay_reconciliation_open_mismatches", "legendFormat": "open mismatches" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API 거절 사유",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (code) (rate(paritypay_api_rejections_total[1m]))", "legendFormat": "{{code}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 지연 (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p50 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p95 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p99 {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "소비자 적체 (consumer lag / 소비 속도)",
      "description": "Outbox 적체가 '발행이 밀리는가'라면 이것은 '소비가 밀리는가'입니다. 둘은 다른 사고입니다 \u2014 발행이 멈추면 이벤트가 브로커에 없고, 소비가 멈추면 브로커에는 있는데 프로젝션과 정산이 따라오지 못합니다. records_lag_max는 소비자별 최대 파티션 지연 건수입니다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "kafka_consumer_fetch_manager_records_lag_max", "legendFormat": "{{client_id}} lag" },
        { "expr": "kafka_consumer_fetch_manager_records_consumed_rate", "legendFormat": "{{client_id}} rate" }
      ]
    },
    {
      "type": "timeseries",
      "title": "소비자 재분배 (rebalance)",
      "description": "재분배는 같은 이벤트가 두 인스턴스에 걸치는 순간을 만듭니다. 소비자가 멱등하므로 결과가 두 번 생기지는 않지만(M-002), 재분배가 잦으면 소비가 계속 끊긴다는 뜻입니다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "kafka_consumer_coordinator_last_rebalance_seconds_ago", "legendFormat": "{{client_id}} 마지막 재분배 이후(s)" },
        { "expr": "kafka_consumer_coordinator_failed_rebalance_total", "legendFormat": "{{client_id}} 실패한 재분배" },
        { "expr": "kafka_consumer_coordinator_assigned_partitions", "legendFormat": "{{client_id}} 할당 파티션" }
      ]
    }
  ]
}
